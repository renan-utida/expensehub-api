{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ExpenseHub": "Data Source=expensehub.db"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Admin": {
      "Email": "admin@expensehub.local"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "QueueName": "expensehub.reports"
  },
  "AllowedHosts": "*"
}
