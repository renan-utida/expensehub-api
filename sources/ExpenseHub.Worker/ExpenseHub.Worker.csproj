<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>de5b8d73-b3de-4144-9c9b-169e6e739bf0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpenseHub.Api\ExpenseHub.Api.csproj" />
  </ItemGroup>

  <!--
    The web project is a content file source: its appsettings.json flows to the publish output through the project reference and
    has the same relative path as the one of the worker, which the SDK refuses (NETSDK1152). The worker publishes its own file
    (settings of the broker only, no connection string). The duplicate check stays on; only the file of the web project is removed.
  -->
  <Target Name="UseWorkerAppSettingsOnPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <PropertyGroup>
      <WebProjectAppSettings>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\ExpenseHub.Api\appsettings.json'))</WebProjectAppSettings>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="$(WebProjectAppSettings)" />
    </ItemGroup>
  </Target>

</Project>
